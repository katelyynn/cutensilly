{
	"tasks": {
		"dev": "deno run -P=default --watch src/mod.ts",
		"build": "deno run -P=default src/mod.ts"
	},
	"imports": {
		"@404/aether": "jsr:@404/aether@0.3.0",
		"@fontsource-variable/bricolage-grotesque": "npm:@fontsource-variable/bricolage-grotesque@^5.3.0",
		"@std/assert": "jsr:@std/assert@1"
	},
	"permissions": {
		"default": {
			"net": true,
			"read": true,
			"run": true,
			"env": true,
			"write": true
		}
	},
	"compilerOptions": {
		"jsx": "react-jsx",
		"jsxImportSource": "@404/aether",
		"lib": [
			"deno.ns",
			"dom",
			"dom.iterable"
		]
	},
	"fmt": {
		"singleQuote": true,
		"indentWidth": 4,
		"useTabs": true
	},
	"lint": {
		"rules": {
			"exclude": [
				"no-sloppy-imports",
				"no-window"
			]
		}
	}
}
